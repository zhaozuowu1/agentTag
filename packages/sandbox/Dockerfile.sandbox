FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    MPLCONFIGDIR=/tmp/mpl \
    MATPLOTLIBRC=/etc/matplotlibrc \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
       curl \
       ca-certificates \
       fontconfig \
       fonts-noto-cjk \
  && rm -rf /var/lib/apt/lists/* \
  && pip install matplotlib pandas fonttools \
  && useradd --create-home --uid 1000 --shell /usr/sbin/nologin sandbox \
  && mkdir -p /workspace /tmp/mpl \
  && chown -R sandbox:sandbox /workspace /tmp/mpl

COPY mpl/matplotlibrc /etc/matplotlibrc
COPY mpl/prepare_cjk_font.py /tmp/prepare_cjk_font.py
RUN python3 /tmp/prepare_cjk_font.py \
  && rm -f /tmp/prepare_cjk_font.py

USER sandbox
WORKDIR /workspace
CMD ["sleep", "600"]
