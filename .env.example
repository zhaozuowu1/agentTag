# 飞书企业自建应用（中国区 open.feishu.cn）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 开发用 SDK 长连接时可不填。生产 NODE_ENV=production 走 HTTP 订阅时必填。
FEISHU_ENCRYPT_KEY=
FEISHU_VERIFICATION_TOKEN=
# 可选覆盖：websocket | http。默认非 production 为 websocket，production 为 http。
# FEISHU_EVENT_MODE=

# 组织持有的 Anthropic API。国内网络请配置兼容网关。
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

DATABASE_URL=postgres://agenttag:agenttag@localhost:5432/agenttag
REDIS_URL=redis://localhost:6379

# 管理台 Bearer Token
ADMIN_TOKEN=

# 凭证库主密钥（32 字节 hex）。MVP 阶段解析即可，阶段 4 起才用于加密连接。
CREDENTIAL_MASTER_KEY=
