# 飞书企业自建应用（中国区 open.feishu.cn）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 开发用 SDK 长连接时可不填。生产 NODE_ENV=production（或未设 NODE_ENV）走 HTTP 订阅时必填。
FEISHU_ENCRYPT_KEY=
FEISHU_VERIFICATION_TOKEN=
# 可选覆盖：websocket | http。默认 development/test 为 websocket，其余为 http。
# FEISHU_EVENT_MODE=

# 阿里云百炼（DashScope）OpenAI 兼容接口。服务端模型调用走这里。
# 个人 Claude Code / Codex / Cursor / Grok 订阅不能当服务端。
DASHSCOPE_API_KEY=
# 默认 https://dashscope.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_BASE_URL=
# 默认 qwen3.8-max（请求里会显式关思考）。管理台可覆盖，改完下一轮生效、不必重启 Worker。
# DASHSCOPE_MODEL=qwen3.8-max

# 可选，不再作为启动条件。国内 Anthropic 兼容网关如需保留可填，但不参与默认模型调用。
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=

DATABASE_URL=postgres://agenttag:agenttag@localhost:5432/agenttag
REDIS_URL=redis://localhost:6379

# 管理台 Bearer Token
ADMIN_TOKEN=

# 凭证库主密钥（32 字节 hex）。MVP 阶段解析即可，阶段 4 起才用于加密连接。
CREDENTIAL_MASTER_KEY=
