# 飞书企业自建应用（中国区 open.feishu.cn）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_ENCRYPT_KEY=
FEISHU_VERIFICATION_TOKEN=

# 组织持有的 Anthropic API。国内网络请配置兼容网关。
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

DATABASE_URL=postgres://agenttag:agenttag@localhost:5432/agenttag
REDIS_URL=redis://localhost:6379

# 管理台 Bearer Token
ADMIN_TOKEN=

# 凭证库主密钥（32 字节 hex）。MVP 阶段解析即可，阶段 4 起才用于加密连接。
CREDENTIAL_MASTER_KEY=
